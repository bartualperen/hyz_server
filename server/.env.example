# Sunucu yapılandırması (docker-compose ya da `uvicorn` ile lokal çalıştırma için)
DATABASE_URL=sqlite:///./data/app.db
PUBLIC_URL=http://localhost:8000/
MEDIA_ROOT=./data/media

# Açılışta örnek dataset + varsayılan client/session otomatik oluşturulsun mu?
AUTO_SEED=true

# Gerçekçi yarışma kısıtları (frames/translation 5/dk, prediction 80/dk).
# Lokal testte hızlı olması için varsayılan KAPALI.
RATE_LIMIT_ENABLED=false

# AUTO_SEED ile oluşturulacak varsayılan takım
DEFAULT_TEAM_NAME=test_team
DEFAULT_TEAM_PASSWORD=test
